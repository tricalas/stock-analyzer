# Database
DATABASE_URL=sqlite:///./stock_analyzer.db

# Redis (API cache and Celery worker queue)
REDIS_URL=redis://localhost:6379

# Security
ENVIRONMENT=development
# Generate a production key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional recovery login. Empty disables it.
SUPER_PIN=

# CORS - 프로덕션 환경에서는 실제 도메인으로 변경
# 여러 도메인은 쉼표로 구분
CORS_ORIGINS=http://localhost:3000,https://tricalas.com,https://www.tricalas.com,https://stock-analyzer-frontend.vercel.app

# 한국투자증권 Open API 설정
# API 키 발급: https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=
KIS_ACCOUNT_CODE=
KIS_IS_MOCK=true

# Automatic jobs run in America/New_York time and follow DST.
ENABLE_AUTO_HISTORY_COLLECTION=false
HISTORY_COLLECTION_DAYS=180
HISTORY_COLLECTION_MODE=all

# Railway API: api; Celery services: worker
APP_ROLE=api
